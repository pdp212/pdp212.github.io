# ════════════════════════════════════════════════════════════════════
# .env.example — MẪU CẤU HÌNH TOKEN GITHUB
# ════════════════════════════════════════════════════════════════════
#
# HƯỚNG DẪN:
# 1. Copy file này thành file tên ".env" (không có chữ "example")
#    cp .env.example .env
#
# 2. Điền token GitHub cá nhân vào bên dưới
#    (Lấy tại: https://github.com/settings/tokens/new)
#    Quyền cần chọn: [x] repo (full control)
#
# 3. Chạy deploy: bash deploy.sh
#
# ⚠️ QUAN TRỌNG: File .env đã được thêm vào .gitignore
#    nên token của bạn KHÔNG bị push lên GitHub.
# ════════════════════════════════════════════════════════════════════

GITHUB_TOKEN=ghp_your_token_here
GITHUB_USER=pdp212
GITHUB_REPO=pdp212.github.io
