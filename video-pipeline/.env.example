# ==============================================================================
# Cloudflare R2 Credentials (S3-Compatible API)
# ==============================================================================
# Your Cloudflare Account ID (found on Cloudflare Dashboard URL or Overview)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 API Token with Object Read & Write permissions for bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Optional: Override bucket name if different from pipeline.config.json
R2_BUCKET_NAME=pdp212-profile

# ==============================================================================
# GitHub Credentials
# ==============================================================================
# Personal Access Token (PAT) with repo and workflow scopes for GitHub Actions monitoring
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
