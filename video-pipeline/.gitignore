# Dependencies
node_modules/
dist/

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.env.local

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Pipeline working directories (keep folder structure, ignore contents)
temp/*
!temp/.gitkeep
assets/videos/projects/*.mp4
encoded/*
!encoded/.gitkeep
completed/*
!completed/.gitkeep
failed/*
!failed/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
